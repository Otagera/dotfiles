// General-purpose dev layout: nvim + shell + lazygit, with the default
// tab-bar/status-bar so keybindings stay discoverable while getting used
// to zellij. File browsing uses nvim's own built-in explorer (<leader>e)
// since it opens directly into the same editor instance. yazi and the LLM
// CLI each get their own full-screen tab — both were too cramped as a
// shared pane quadrant.
//
// Usage: zellij --layout dev   (or the `dev` shell alias)
//
// No cwd is set here on purpose — panes inherit whatever directory
// you launched zellij from, so this works the same in any project.

layout {
    default_tab_template {
        pane size=1 borderless=true {
            plugin location="zellij:tab-bar"
        }
        children
        pane size=2 borderless=true {
            plugin location="zellij:status-bar"
        }
    }

    tab name="dev" split_direction="vertical" {
        pane size="80%" {
            command "nvim"
        }
        pane split_direction="horizontal" size="20%" {
            pane focus=true
            pane command="lazygit"
        }
    }

    tab name="llm" {
        pane command="/Users/othnielagera/dotfiles/bin/llm.sh"
    }

    tab name="files" {
        pane command="yazi"
    }
}
