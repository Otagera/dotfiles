// General-purpose dev layout: editor + shell + lazygit, with the
// default tab-bar/status-bar so keybindings stay discoverable while
// getting used to zellij.
//
// Usage: zellij --layout dev   (or the `dev` shell alias)
//
// No cwd is set here on purpose — panes inherit whatever directory
// you launched zellij from, so this works the same in any project.

layout {
    default_tab_template {
        pane size=1 borderless=true {
            plugin location="zellij:tab-bar"
        }
        children
        pane size=2 borderless=true {
            plugin location="zellij:status-bar"
        }
    }

    tab name="dev" split_direction="vertical" {
        pane size="70%" {
            command "nvim"
        }
        pane split_direction="horizontal" size="30%" {
            pane focus=true
            pane command="lazygit"
        }
    }

    // Full-screen tab for the LLM CLI — a shared pane quadrant is too
    // cramped for reading long responses/diffs comfortably.
    tab name="llm" {
        pane command="/Users/othnielagera/dotfiles/bin/llm.sh"
    }
}
