[user]
	name = Othniel Agera
	email = otagera@gmail.com

[includeIf "gitdir:~/source/ravebyflutterwave/"]
	path = ~/.gitconfig-work

[core]
	excludesfile = ~/.gitignore_global
	filemode = false
	trustctime = false
	autocrlf = input
	untrackedCache = true
	ignorecase = false
	pager = delta

[credential]
	helper = osxkeychain

[pull]
	rebase = true

[rerere]
	enabled = true

[rebase]
	autoStash = true

[init]
	defaultBranch = main

[push]
	followTags = true

[fetch]
	prune = true

[grep]
	lineNumber = true

[help]
	autocorrect = 1

[alias]
	amend = commit --amend --reuse-message=HEAD
	br = branch
	ci = commit
	co = checkout
	contrib = shortlog --summary --numbered
	d = diff
	ds = -c delta.side-by-side=true diff
	g = grep --break --heading --line-number
	p = push
	pf = push --force
	s = status
	unstage = reset --hard HEAD
	l = log --graph --abbrev-commit --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset'
	ld = "!sh -c \"git log --since '${1:-1} days ago' --oneline --author $(git config user.email)\" -"
	ll = log --graph --abbrev-commit --pretty=oneline
	lm = log --pretty=format:'* %s (%h)'
	patch = !git --no-pager diff --no-color
	show-ignored = !git clean -ndX | perl -pe 's/Would remove //'

[diff]
	renames = copies
	indentHeuristic = true
	colorMoved = default

[merge]
	conflictstyle = diff3
	defaultToUpstream = true

[delta]
	navigate = true
	light = false

[color]
	ui = auto
